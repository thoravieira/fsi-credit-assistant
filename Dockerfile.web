# Build context: ./frontend (see docker-compose.yml). NEXT_PUBLIC_* vars are
# inlined into the client bundle at build time, not read at runtime — the
# browser calls /api/chat directly, so this must be an address the *browser*
# (not the Docker network) can reach, i.e. localhost, not the `api` service name.
FROM node:20-slim

WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .

ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG NEXT_PUBLIC_GIT_REF=fix/inverse-simulation-and-journey-ux
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_GIT_REF=$NEXT_PUBLIC_GIT_REF
RUN npm run build

EXPOSE 3000
CMD ["npm", "run", "start"]
