# Copy to .env and fill in. NEVER commit .env — it is git-ignored.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# MongoDB Atlas
# ---------------------------------------------------------------------------
# Connection string for the DEDICATED DATABASE USER (not your Atlas login).
# Atlas UI → Database → Connect → Drivers → Python.
# Create the user under Database Access with a role scoped to this database
# only: readWrite on `credit_assistant`. Do NOT use atlasAdmin.
# URL-encode the password if it contains @ : / ? # [ ] %
MONGODB_URI=mongodb+srv://credit_app:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=<cluster>
MONGODB_DB=credit_assistant

# NOTE: the Atlas *Admin API* key pair (public/private, from Organization →
# Access Manager) is NOT needed by this application and must not be placed
# here. Indexes are created through the driver, not the Admin API.

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Exact model id available on your account. Written into decisions_log.model.
#
# Latency matters more than raw capability here: the negotiation node has a
# median-turn budget of 15 s (SDD 06 §6), and every node on the customer path
# is a blocking LLM call in front of an audience. Measured 2026-08-11 over 5
# live /api/chat turns each, same prompts and same seeded data:
#
#   gpt-5.6-sol    turn 10.6 s  (range  6.5-17.4)
#   gpt-5.6-luna   turn  7.2 s  (range  6.3-10.6)   <- current
#
# Luna is ~32% faster on the median and, more usefully for a live demo, has
# roughly half the spread — the worst case is what bites on stage. Extraction
# and citations were identical between the two. Bigger is slower, not better,
# for this workload: gpt-5.5 measured ~10.4 s on the same test.
LLM_MODEL=gpt-5.6-luna

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# voyage | openai — see docs/specs/08-retrieval.md §1
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=pa-...
# Both providers are pinned to 1024. Changing this requires recreating the
# vector indexes AND re-seeding with --reembed.
EMBEDDING_DIMENSIONS=1024

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Optional — LangSmith tracing. Useful while debugging the graph.
# Turn OFF before the live demo: it adds latency to every node.
# ---------------------------------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=fsi-credit-assistant
