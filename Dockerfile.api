# Build context: repository root (see docker-compose.yml). Config is supplied as
# real container environment variables via `env_file:`, not a mounted .env —
# `app/config.py` locates .env by walking up from its own file, which only
# resolves correctly outside a container. The root context also makes the
# policy corpus available to the consistency tests at `/data/policies`.
FROM python:3.12-slim

RUN pip install --no-cache-dir uv

WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev

COPY backend/ .
COPY data/ /data/

EXPOSE 8000
CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
